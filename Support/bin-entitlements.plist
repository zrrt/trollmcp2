<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- v2.9.38：注入工具（bin/cp cp-15 mv mv-15 rm chown ldid insert_dylib install_name_tool optool ct_bypass）执行时所需的 entitlements。
	     iOS 沙箱按每次 exec 的新二进制签名计算：若不签 no-sandbox，这些工具被 root spawn 后仍被套普通沙箱，
	     写其他 App bundle（/private/var/containers/Bundle/Application/...）会 Permission denied。
	     签上后 + TrollStore 安装时保留 → 工具无沙箱执行，配合 spawnRoot(root uid) 可正常注入。 -->
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>task_for_pid-allow</key>
	<true/>
</dict>
</plist>
